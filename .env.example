OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
TELEGRAM_TOKEN=
# Production: Supabase Session pooler (IPv4-compatible), postgres role.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# SQLite fallback only: leave DATABASE_URL empty to use this path.
DB_PATH=./libreta.db

# Shared secret: keep it server-side in the frontend.
API_KEY=
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
PORT=8000
# Local development only; production requires API_KEY.
ALLOW_NO_AUTH=0
